# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
# Optional (recommended for server-only backend):
# Use the service role key so the backend can bypass RLS
# DO NOT expose this key to browsers or clients

# Celery/Redis Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Chroma Configuration
CHROMA_PERSIST_DIR=/data/chroma

# LLM Configuration (choose one or both)
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# Application Settings
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800  # 50MB in bytes
CHUNK_SIZE=1000  # tokens
CHUNK_OVERLAP=200  # tokens
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

# LLM Settings
LLM_PROVIDER=gemini  # or 'openai' or 'local'
GEMINI_MODEL=gemini-pro
OPENAI_MODEL=gpt-3.5-turbo
